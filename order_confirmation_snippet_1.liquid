{%- comment -%}
  Write with Us — saved card messages in the order confirmation email.

  Reads the "Saved Card Messages" cart attribute (a delimited string, not JSON —
  Shopify's notification Liquid has no filter to parse JSON back into an object,
  only "split", so this format is built for that).

  Format: "Card Title|||Message text@@@Card Title 2|||Message text 2"

  For each saved message, this checks whether a line item in THIS order matches
  the card title. If it matches, it's shown under "Messages for cards in this
  order". If it doesn't match (the person saved a message for a card they didn't
  end up buying), it's shown under a second, clearly separate section — nothing
  is dropped, per the decision to always include the full clipboard.
{%- endcomment -%}

{%- assign saved_messages_raw = attributes['Saved Card Messages'] -%}
{%- if saved_messages_raw and saved_messages_raw != empty -%}
  {%- assign saved_entries = saved_messages_raw | split: '@@@' -%}

  <div style="margin: 24px 0; padding: 20px; background: #faf8f5; border-radius: 10px; border: 1px solid #e5e0e3;">
    <h2 style="font-size: 18px; margin: 0 0 12px;">Your saved card messages</h2>

    {%- assign matched_count = 0 -%}
    {%- for entry in saved_entries -%}
      {%- assign parts = entry | split: '|||' -%}
      {%- assign saved_card_title = parts[0] -%}
      {%- assign saved_message_text = parts[1] -%}

      {%- assign is_matched = false -%}
      {%- for line in line_items -%}
        {%- if line.title == saved_card_title -%}
          {%- assign is_matched = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if is_matched -%}
        {%- assign matched_count = matched_count | plus: 1 -%}
        <div style="margin-bottom: 14px; padding: 14px; background: #ffffff; border-radius: 8px; border: 1px solid #e5e0e3;">
          <div style="font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #af95a6; font-weight: 700; margin-bottom: 6px;">
            For your {{ saved_card_title }}
          </div>
          <div style="font-family: Georgia, serif; font-size: 15px; line-height: 1.5; color: #2c2d2e;">
            {{ saved_message_text }}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Second pass: unmatched messages (saved but not purchased this time) {%- endcomment -%}
    {%- assign unmatched_entries = '' -%}
    {%- for entry in saved_entries -%}
      {%- assign parts = entry | split: '|||' -%}
      {%- assign saved_card_title = parts[0] -%}
      {%- assign saved_message_text = parts[1] -%}
      {%- assign is_matched = false -%}
      {%- for line in line_items -%}
        {%- if line.title == saved_card_title -%}
          {%- assign is_matched = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless is_matched -%}
        <div style="margin-bottom: 14px; padding: 14px; background: #ffffff; border-radius: 8px; border: 1px dashed #d8cbae;">
          <div style="font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #999; font-weight: 700; margin-bottom: 6px;">
            Saved for later — {{ saved_card_title }}
          </div>
          <div style="font-family: Georgia, serif; font-size: 15px; line-height: 1.5; color: #2c2d2e;">
            {{ saved_message_text }}
          </div>
        </div>
      {%- endunless -%}
    {%- endfor -%}
  </div>
{%- endif -%}
